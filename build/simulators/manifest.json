{
	"modules": {
		"*": [
			"./modules/screen",
			"$(MODULES)/base/time/*",
			"$(MODULES)/base/time/$(PLATFORM)/*",
			"$(MODULES)/base/timer/timer",
			"$(MODULES)/base/timer/$(PLATFORM)/*",
			"$(EMBEDDED)/common/builtinCommon"
		],
		"setup/sim": "./modules/setup-sim",
		"lockdown/device": "$(EMBEDDED)/system/lockdowndevice",
		"embedded:provider/builtin": "$(EMBEDDED)/provider/builtin/$(PLATFORM)/provider"
	},
	"preload": [
		"time",
		"timer",
		"setup/sim",
		"lockdown/device",
		"embedded:provider/builtin"
	],
	"platforms": {
		"lin": {
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"lin/*": {
			"build": {
				"SIMULATORS": "$(BUILD_SIMULATOR)"
			},
			"include": "./$(SUBPLATFORM)",
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"mac": {
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"mac/*": {
			"build": {
				"SIMULATORS": "$(BUILD_SIMULATOR)"
			},
			"include": "./$(SUBPLATFORM)",
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"win": {
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"win/*": {
			"build": {
				"SIMULATORS": "$(BUILD_SIMULATOR)"
			},
			"include": "./$(SUBPLATFORM)",
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"wasm": {
		},
		"wasm/*": {
			"include": "./$(SUBPLATFORM)"
		}
	}
}
