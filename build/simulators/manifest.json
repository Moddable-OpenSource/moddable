{
	"modules": {
		"*": [
			"./modules/screen",
			"$(MODULES)/base/time/*",
			"$(MODULES)/base/time/$(PLATFORM)/*",
			"$(MODULES)/base/timer/timer",
			"$(MODULES)/base/timer/$(PLATFORM)/*"
		],
		"setup/sim": "./modules/setup-sim"
	},
	"preload": [
		"time",
		"timer",
		"setup/sim"
	],
	"platforms": {
		"lin": {
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"lin/*": {
			"build": {
				"SIMULATORS": "$(BUILD_SIMULATOR)"
			},
			"include": "./$(SUBPLATFORM)/manifest.json",
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"mac": {
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"mac/*": {
			"build": {
				"SIMULATORS": "$(BUILD_SIMULATOR)"
			},
			"include": "./$(SUBPLATFORM)/manifest.json",
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"win": {
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"win/*": {
			"build": {
				"SIMULATORS": "$(BUILD_SIMULATOR)"
			},
			"include": "./$(SUBPLATFORM)/manifest.json",
			"modules": {
				"*": [
					"$(MODULES)/base/timer/modTimer"
				]
			}
		},
		"wasm": {
		},
		"wasm/*": {
			"include": "./$(SUBPLATFORM)/manifest.json"
		}
	}
}
