{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_commodetto.json",
		"$(MODDABLE)/modules/base/debug",
		"$(MODDABLE)/modules/base/ffi",
		"$(MODDABLE)/modules/base/instrumentation",
		"$(MODDABLE)/modules/data/headers",
		"$(MODDABLE)/modules/data/qrcode",
		"$(MODDABLE)/modules/data/url",
		"$(MODDABLE)/modules/io/files",
		"$(MODDABLE)/modules/io/storage",
		"$(MODDABLE)/build/devices/pebble/modules/global",
		"$(MODDABLE)/build/devices/pebble/modules/display",
		"$(MODDABLE)/build/devices/pebble/modules/poco",
		"$(MODDABLE)/build/devices/pebble/modules/button",
		"$(MODDABLE)/build/devices/pebble/modules/message",
		"$(MODDABLE)/build/devices/pebble/modules/accelerometer",
		"$(MODDABLE)/build/devices/pebble/modules/battery",
		"$(MODDABLE)/build/devices/pebble/modules/compass",
		"$(MODDABLE)/build/devices/pebble/modules/location",
		"$(MODDABLE)/build/devices/pebble/modules/archive-resource",
		"$(MODDABLE)/build/devices/pebble/modules/httpclient",
		"$(MODDABLE)/build/devices/pebble/modules/websocketclient",
		"$(MODDABLE)/build/devices/pebble/modules/touch",
		"$(MODDABLE)/build/devices/pebble/modules/vibes",
		"$(MODDABLE)/build/devices/pebble/modules/wakeup",
		"$(MODDABLE)/build/devices/pebble/modules/dictation",
		"$(MODDABLE)/build/devices/pebble/modules/health",
		"$(MODDABLE)/modules/piu/Pebble"
	],
	"config": {
		"screen": "pebble/display",
		"touchCount": 1
	},
	"modules": {
		"*": [
			"./main",
			"./main-appinfo",
			"$(MODDABLE)/examples/io/storage/webstorage/webstorage.js",
			"$(MODDABLE)/examples/io/tcp/fetch/fetch.js",
			"$(MODDABLE)/examples/io/tcp/websocket/WebSocket.js"
		]
	},
	"preload": [
		"main",
		"webstorage",
		"fetch",
		"WebSocket"
	],
	"strip": [
		"Proxy",
		"Reflect",
		"Atomics",
		"WeakMap",
		"WeakSet",
		"BigInt",
		"eval",
		"Function",
		"Generator"
	]
}
