{
	"build": {
		"EXPECTED_ESP_IDF": "v6.1",
		"IDF_COMPONENTS_CORE": "main esptool_py partition_table bootloader nvs_flash esp_netif"
	},
	"modules": {
		"*": [
			"$(MODULES)/base/time/*",
			"$(MODULES)/base/time/esp/*",
			"$(MODULES)/base/timer/*",
			"$(MODULES)/base/timer/mc/*",
			"$(MODULES)/pins/digital/esp32/modGPIO",
			"$(IO)/common/builtinCommon"
		],
		"lockdown/device": "$(IO)/system/lockdowndevice"
	},
	"preload": [
		"time",
		"timer",
		"lockdown/device",
		"embedded:provider/builtin"
	],
	"platforms": {
		"esp32": {
			"error": "esp32 subplatform required (e.g. -p esp32/moddable_two)"
		},
		"esp32/*": {
			"include": "$(SUBPLATFORMMANIFEST)",
			"dependency": [
				{ "idf": "esp_driver_gptimer" }
			],
			"modules": {
				"embedded:provider/builtin": "$(SUBPLATFORMDIRECTORY)/host/provider"
			}
		}
	}
}
