{
	"build": {
		"ESP32_SUBCLASS": "esp32s3",
		"USE_USB": "2",
		"SDKCONFIGPATH": "./sdkconfig",
		"PARTITIONS_FILE_FOR_TARGET": "./sdkconfig/partitions.csv",
		"PROGRAMMING_MODE_MESSAGE": "Hold the power button until the green LED flashes, then release to enter download mode.",
		"BEFORE_DEBUGGING_MESSAGE": "Press the PWR button to restart."
	},
	"include": [
		"$(MODULES)/drivers/co5300",
		"$(MODULES)/drivers/sensors/cst820",
		"$(MODULES)/drivers/sensors/cst9217",
		"$(MODULES)/drivers/peripherals/button",
		"$(IO)/digital",
		"$(IO)/i2c"
	],
	"modules": {
		"setup/target": "./setup-target",
		"m5stack_stopwatch/m5ioe1": "./M5IOE1",
		"m5stack_stopwatch/m5pm1": "./M5PM1",
		"m5stack_stopwatch/es8311": "./ES8311",
		"m5stack_stopwatch/audio": "./host/audio-provider",
		"embedded:io/audio/in-original": "$(EMBEDDED)/io/audio/in/esp32/audioin",
		"embedded:io/audio/out-original": "$(EMBEDDED)/io/audio/out/esp32/audioout-esp32",
		"embedded:io/audio/in": "./host/audio-in",
		"embedded:io/audio/out": "./host/audio-out"
	},
	"platforms": {
		"esp32": {
			"dependency": [
				{ "idf": "esp_driver_i2s" },
				{ "idf": "esp_adc" }
			]
		}
	},
	"preload": [
		"embedded:io/audio/in",
		"embedded:io/audio/out",
		"setup/target"
	],
	"config": {
		"screen": "co5300",
		"format": "RGB565BE",
		"corner": 233
	},
	"creation": {
		"static": 0,
		"chunk": {
			"initial": 78848,
			"incremental": 0
		},
		"heap": {
			"initial": 4928,
			"incremental": 0
		},
		"stack": 512
	},
	"defines": {
		"i2c": {
			"sda_pin": 47,
			"scl_pin": 48
		},
		"co5300": {
			"width": 466,
			"height": 466,
			"hz": 40000000,
			"cs_pin": 39,
			"sck_pin": 40,
			"data0_pin": 41,
			"data1_pin": 42,
			"data2_pin": 46,
			"data3_pin": 45,
			"column_offset": 6,
			"row_offset": 0,
			"spi_port": "SPI2_HOST"
		},
		"audioOut": {
			"bitsPerSample": 16,
			"numChannels": 1,
			"sampleRate": 16000,
			"i2s": {
				"bitsPerSample": 16,
				"bck_pin": 17,
				"lr_pin": 15,
				"mck_pin": 18,
				"dataout_pin": 21,
				"slot": "I2S_STD_SLOT_LEFT",
				"format_i2s": 1
			}
		},
		"audioIn": {
			"sampleRate": 16000,
			"bitsPerSample": 16,
			"numChannels": 1,
			"i2s": {
				"num": 0,
				"bck_pin": 17,
				"lr_pin": 15,
				"mck_pin": 18,
				"datain": 16,
				"slot": "I2S_STD_SLOT_BOTH",
				"format_i2s": 1
			}
		}
	}
}
