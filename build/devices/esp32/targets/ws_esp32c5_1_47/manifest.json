{
	"include": [
		"$(MODULES)/drivers/peripherals/backlight/manifest.json",
		"$(MODULES)/drivers/peripherals/button/manifest.json",
		"$(MODULES)/drivers/peripherals/led/neopixel/manifest.json",
		"$(MODULES)/drivers/st7789/manifest.json",
		"$(IO)/digital/manifest.json",
		"$(IO)/pwm/manifest.json"
	],
	"build":{
		"ESP32_SUBCLASS": "esp32c5",
		"USE_USB": "2",
		"PROGRAMMING_MODE_MESSAGE": "INSTRUCTIONS: Hold the BOOT button and press then release the RST button.",
		"BEFORE_DEBUGGING_MESSAGE": "Press and release the RST button."
	},
	"modules": {
		"setup/target": "./setup-target"
	},
	"preload": [
		"setup/target",
		"neopixel"
	],
	"config": {
		"screen": "st7789",
		"backlight": 10,
		"brightness": 50,
		"led": {
			"pin": 8,
			"rainbow": true,
			"brightness": 32
		}
	},
	"creation": {
		"static": 0,
		"chunk": {
			"initial": 78848,
			"incremental": 0
		},
		"heap": {
			"initial": 4928,
			"incremental": 0
		},
		"stack": 512
	},
	"defines": {
		"i2c": {
			"sda_pin": 2,
			"scl_pin": 3
		},
		"spi": {
			"miso_pin": 5,
			"mosi_pin": 6,
			"sck_pin": 7
		},
		"ili9341": {
			"width": 172,
			"height": 320,
			"hz": 40000000,
			"cs_pin": 23,
			"dc_pin": 24,
			"rst_pin": 26,
			"spi_port": "SPI2_HOST",
			"row_offset": 0,
			"column_offset": 34,
			"spi_mode": "0"
		}
	}
}
