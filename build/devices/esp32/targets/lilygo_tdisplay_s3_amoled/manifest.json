{
	"build": {
		"ESP32_SUBCLASS": "esp32s3",
		"USE_USB": "2",
		"SDKCONFIGPATH": "./sdkconfig",
		"PARTITIONS_FILE_FOR_TARGET": "./sdkconfig/partitions.csv",
		"PROGRAMMING_MODE_MESSAGE": "INSTRUCTIONS: Press and hold the BOOT button, then press and release the RST button.",
		"BEFORE_DEBUGGING_MESSAGE": "Press and release the RST button."
	},
	"include": [
		"$(MODULES)/drivers/co5300",
		"$(MODULES)/drivers/peripherals/button",
		"$(MODULES)/drivers/peripherals/led/digital",
		"$(IO)/digital"
	],
	"modules": {
		"setup/target": "./setup-target"
	},
	"preload": ["setup/target"],
	"config": {
		"screen": "co5300",
		"touch": "",
		"format": "RGB565BE"
	},
