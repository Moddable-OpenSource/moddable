			"width": 240,
			"height": 536,
			"hz": 40000000,
			"column_offset": 0,
			"row_offset": 0,
			"cs_pin": 6,
			"sck_pin": 47,
			"data0_pin": 18,
			"data1_pin": 7,
			"data2_pin": 48,
			"data3_pin": 5,
			"rst_pin": 17,
			"spi_port": "SPI2_HOST",
			"rm67162": 1
		},
		"poco": {
			"dma": 1
		}
	}
