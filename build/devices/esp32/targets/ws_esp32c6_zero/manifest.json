{
	"build": {
		"ESP32_SUBCLASS": "esp32c6",
		"USE_USB": "2",
		"PROGRAMMING_MODE_MESSAGE": "INSTRUCTIONS: Hold the BOOT button and press then release the RST button.",
		"BEFORE_DEBUGGING_MESSAGE": "Press and release the RST button."
	},
	"include": [
		"$(MODULES)/drivers/peripherals/button",
		"$(MODULES)/drivers/peripherals/led/neopixel",
		"$(IO)/digital"
	],
	"modules": {
		"setup/target": "./setup-target"
	},
	"preload": [
		"setup/target"
	],
	"config": {
		"screen": "",
		"led": {
			"pin": 8,
			"rainbow": true,
			"brightness": 32
		}
	},
	"creation": {
		"static": 0,
		"chunk": {
			"initial": 78848,
			"incremental": 0
		},
		"heap": {
			"initial": 4928,
			"incremental": 0
		},
		"stack": 512
	},
	"defines": {
		"i2c": {
			"sda_pin": 14,
			"scl_pin": 15
		},
		"spi": {
			"miso_pin": 20,
			"mosi_pin": 19,
			"sck_pin": 21
		}
	}
}
