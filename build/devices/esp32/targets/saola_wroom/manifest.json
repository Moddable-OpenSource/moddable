{
	"build":{
		"ESP32_SUBCLASS": "esp32s2"
	},
	"include": [
		"$(MODULES)/drivers/peripherals/button",
		"$(MODULES)/drivers/peripherals/led/neopixel",
		"$(IO)/digital"
	],
	"modules": {
		"setup/target": "./setup-target"
	},
	"preload": [
		"setup/target"
	],
	"config": {
		"screen": "",
		"led": {
			"pin": 18,
			"rainbow": true,
			"brightness": 128
		}
	},
	"creation": {
		"static": 94208,
		"chunk": {
			"initial": 1536,
			"incremental": 512
		},
		"heap": {
			"initial": 512,
			"incremental": 64
		},
		"stack": 384
	},
	"defines": {
		"i2c": {
			"sda_pin": 20,
			"scl_pin": 19
		},
		"spi": {
			"miso_pin":8,
			"mosi_pin":9,
			"sck_pin": 15
		}
	}
}
