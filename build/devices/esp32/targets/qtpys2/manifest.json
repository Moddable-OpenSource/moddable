{
	"build":{
		"ESP32_SUBCLASS": "esp32s2",
		"USE_USB": "1",
		"PROGRAMMING_VID": "303a",
		"PROGRAMMING_PID": "0002",
		"SDKCONFIGPATH": "./sdkconfig",
		"PROGRAMMING_MODE_MESSAGE": "INSTRUCTIONS: Hold the BOOT button and press then release the RESET button to begin.",
		"BEFORE_DEBUGGING_MESSAGE": "Press and release the RESET button."
	},
	"include": [
		"$(MODULES)/drivers/peripherals/button/manifest.json",
		"$(MODULES)/drivers/peripherals/led/neopixel/manifest.json",
		"$(IO)/digital/manifest.json"
	],
	"modules": {
		"setup/target": "./setup-target"
	},
	"preload": [
		"setup/target"
	],
	"config": {
		"screen": "",
		"led": {
			"power": 38,
			"pin": 39,
			"rainbow": false,
			"brightness": 32
		}
	},
	"defines": {
		"i2c": {
			"sda_pin": 41,
			"scl_pin": 40
		},
		"spi": {
			"miso_pin":37,
			"mosi_pin":35,
			"sck_pin": 36
		}
	}
}
