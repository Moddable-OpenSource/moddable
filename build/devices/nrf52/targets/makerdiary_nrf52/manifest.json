{
	"build": {
		"USE_USB": "1",
		"UF2_VOLUME_NAME": "MODDABLEnRF"
	},
	"include": [
		"$(MODULES)/drivers/peripherals/button",
		"$(MODULES)/drivers/peripherals/led/rgb",
		"$(IO)/digital",
		"$(IO)/pwm"
	],
	"config": {
		"led1_pin": 22,
		"led2_pin": 23,
		"led3_pin": 24,

		"button1_pin": 18
	},
	"defines": {
		"xdebugger": {
			"tx_pin": "NRF_GPIO_PIN_MAP(0,30)",
			"rx_pin": "NRF_GPIO_PIN_MAP(0,31)",
			"baud": "NRF_UART_BAUDRATE_115200"
		},
		"spi": {
			"interface": "2",
			"hz": "2000000",
			"mosi_pin": 4,
			"miso_pin": 5,
			"sck_pin": 6
		},
		"i2c": {
			"interface": "0",
			"scl_pin": 19,
			"sda_pin": 20
		}
	}
}
