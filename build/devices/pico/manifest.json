{
	"build": {
		"EXPECTED_PICO_SDK": "2.3.1",
		"PICO_ROOT ?=": "$(HOME)/pico",
		"PICO_SDK_DIR ?=": "$(PICO_ROOT/pico-sdk",
		"PICO_EXTRAS_DIR ?=": "$(PICO_ROOT)/pico-extras",
		"PICO_EXAMPLES_DIR ?=": "$(PICO_ROOT)/pico-examples"
	},
	"include": [
	],
	"modules": {
		"*": [
			"$(MODULES)/base/time/*",
			"$(MODULES)/base/time/esp/*",
			"$(MODULES)/base/timer/*",
			"$(MODULES)/base/timer/mc/*",
			"$(IO)/common/builtinCommon"
		],
		"lockdown/device": "$(IO)/system/lockdowndevice"
	},
	"creation": {
		"static": 131072,
		"chunk": {
			"initial": 1536,
			"incremental": 512
		},
		"heap": {
			"initial": 512,
			"incremental": 64
		},
		"stack": 512
	},
	"preload": [
		"timer",
		"time",
		"lockdown/device",
		"embedded:provider/builtin"
	],
	"platforms": {
		"pico": {
			"error": "pico subplatform required (e.g. -p pico/pico_2)"
		},
		"pico/*": {
			"include": "$(SUBPLATFORMMANIFEST)",
			"modules": {
				"embedded:provider/builtin": "$(SUBPLATFORMDIRECTORY)/host/provider"
			}
		}
	}
}
