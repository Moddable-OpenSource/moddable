{
	"build": {
		"PICO_SUBCLASS": "rp2350"
	},
	"include": [
		"$(MODULES)/drivers/gc9a01/manifest.json",
		"$(MODULES)/drivers/peripherals/backlight/manifest.json",
		"$(MODULES)/drivers/sensors/cst816s/manifest.json",
		"$(MODULES)/drivers/sensors/qmi8658/manifest.json",
		"$(IO)/digital/manifest.json",
		"$(IO)/i2c/manifest.json",
		"$(IO)/pwm/manifest.json"
	],
	"config": {
		"screen": "gc9a01",
		"backlight": 25,
		"brightness": 50,
		"touch": "",
		"corner": 120
	},
	"defines": {
		"i2c": {
			"sda_pin": 6,
			"scl_pin": 7,
			"port": 1
		},
		"spi": {
			"mosi_pin": 11,
			"sck_pin": 10
		},
		"ili9341": {
			"cs_pin": 9,
			"dc_pin": 8,
			"rst_pin": 13,
			"spi_port": 1,
			"backlight_pin": 25,
			"backlight_on": 1,
			"flipx": true
		}
	}
}
