{
	"build": {
		"PICO_BOARD": "pimoroni_pico_plus2_rp2350",
		"PICO_SUBCLASS": "rp2350"
	},
	"include": [
		"$(MODULES)/drivers/peripherals/button",
		"$(MODULES)/drivers/peripherals/led/pwm",
		"$(MODULES)/drivers/gc9a01",
		"$(IO)/digital",
		"$(IO)/pwm"
	],
	"config": {
		"screen": "ili9341",
		"led": {
			"pin": 25
		}
	},
	"defines": {
		"i2c": {
			"sda_pin": 4,
			"scl_pin": 5
		},
		"spi": {
			"miso_pin": 20,
			"mosi_pin": 19,
			"sck_pin": 18
		},
		"ili9341": {
			"cs_pin": 17,
			"dc_pin": 16,
			"spi_port": 0
		}
	}
}
