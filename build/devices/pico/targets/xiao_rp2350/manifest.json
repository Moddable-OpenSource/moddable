{
	"build": {
		"PICO_SUBCLASS": "rp2350"
	},
	"include": [
		"$(MODULES)/drivers/peripherals/button/manifest.json",
		"$(MODULES)/drivers/peripherals/led/pwm/manifest.json",
		"$(MODULES)/drivers/peripherals/led/neopixel/manifest.json",
		"$(IO)/digital/manifest.json",
		"$(IO)/pwm/manifest.json"
	],
	"modules": {
		"setup/target": "./setup-target"
	},
	"preload": [
		"setup/target"
	],
	"config": {
		"screen": "",
		"touch": "",
		"led": {
			"power": 23,
			"pin": 22,
			"rainbow": true,
			"brightness": 32
		}
	},
	"defines": {
		"i2c": {
			"sda_pin": 6,
			"scl_pin": 7
		},
		"spi": {
			"miso_pin": 4,
			"mosi_pin": 3,
			"sck_pin": 2,
			"cs_pin": 1
		}
	}
}
