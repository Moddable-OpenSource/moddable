{
	"build": {
		"PICO_SUBCLASS": "rp2350",
		"USE_SFE": "1",
		"SFE_CS_PIN": "19",
		"SFE_DIR": "$(MODDABLE)/build/devices/pico/lib/sparkfun-pico",
		"PICO_BOARD_FILE": "$(SFE_DIR)/sparkfun_pico/sfe_pico.h"
	},
	"include": [
		"$(MODULES)/drivers/peripherals/button",
		"$(MODULES)/drivers/peripherals/led/neopixel",
		"$(MODULES)/drivers/gc9a01"
	], "modules": {
		"setup/target": "./setup-target"
	},
	"preload": [
		"setup/target"
	],
	"config": {
		"screen": "ili9341",
		"touch": "",
		"led": {
			"pin": 25,
			"rainbow": false,
			"brightness": 32
		}
	},
	"defines": {
		"i2c": {
			"sda_pin": 17,
			"scl_pin": 16
		},
		"spi": {
			"miso_pin": 23,
			"mosi_pin": 20,
			"sck_pin": 22
		},
		"ili9341": {
			"cs_pin": 21,
			"dc_pin": 7,
			"spi_port": 0
		}
	}
}
