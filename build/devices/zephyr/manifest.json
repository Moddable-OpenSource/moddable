{
	"build": {
		"MAKE_FRAGMENT": "$(MODDABLE)/build/devices/zephyr/config/CMakeLists.txt"
	},
	"include": [
		"$(MODULES)/io",
		"$(MODDABLE)/build/devices/zephyr/modules/rtc",
		"$(MODDABLE)/modules/io/files",
		"$(MODDABLE)/modules/base/modules",
		"$(MODDABLE)/modules/io/display"
	],
	"modules": {
		"*": [
			"$(MODULES)/base/time/*",
			"$(MODULES)/base/time/zephyr/*",
			"$(MODULES)/base/timer/*",
			"$(MODULES)/base/timer/mc/*"
		]
	},
	"preload": [
		"time",
		"timer"
	],
	"creation": {
		"static": 32768,
		"chunk": {
			"initial": 8192
		},
		"heap": {
			"initial": 512
		},
		"stack": 256
	},
	"zephyrConfig": {
		"CONFIG_TIMESLICE_PRIORITY": "5"
	},
	"platforms": {
		"zephyr": {
			"error": "zephyr subplatform required"
		},
		"zephyr/*": {
			"include": "$(SUBPLATFORMMANIFEST)"
		}
	}
}
