{
    "include": [
		"$(MODULES)/drivers/destm32s",
		"$(MODULES)/drivers/peripherals/button",
		"$(MODULES)/drivers/peripherals/led/digital",
		"$(IO)/digital"
    ],
	"build": {
		"FLASH_MODE": "qio",
		"FLASH_SPEED": "80"
	},
    "config": {
        "screen": "destm32s",
        "touch": "",
        "format": "Gray256",
		"rotate": 180
    },
    "defines": {
		"i2c": {
			"sda_pin": 5,
			"scl_pin": 4
		},
        "destm32s": {
            "width": 122,
            "height": 250,
            "moddable_three": 1,
            "colors": "kePaperBlackWhite",
            "cs_pin": 15,
            "dc_pin": 2,
            "rst_pin": 0,
            "busy_pin": 16,
            "spi_port": "#HSPI"
        }
    }
}
