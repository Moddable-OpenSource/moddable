{
	"modules": {
		"*": [
			"$(MODULES)/base/time/*",
			"$(MODULES)/base/time/esp/*",
			"$(MODULES)/base/timer/*",
			"$(MODULES)/base/timer/mc/*",
			"$(MODULES)/pins/digital/esp/modGPIO",
			"$(IO)/common/builtinCommon"
		],
		"lockdown/device": "$(IO)/system/lockdowndevice"
	},
	"creation": {
		"static": 32768,
		"chunk": {
			"initial": 1536,
			"incremental": 512
		},
		"heap": {
			"initial": 512,
			"incremental": 64
		},
		"stack": 256
	},
	"preload": [
		"time",
		"timer",
		"lockdown/device",
		"embedded:provider/builtin"
	],
	"recipes": {
		"strings-in-flash": [
			"commodetto*",
			"piu*",
			"Resource*",
			"mod*",
			"i2c*",
			"digital*"
		],
		"c++11": [
			"*.cc.o",
			"*.cpp.o"
		]
	},
	"platforms": {
		"esp": {
			"error": "esp subplatform required (e.g. -p esp/moddable_one)"
		},
		"esp/*": {
			"include": "$(SUBPLATFORMMANIFEST)",
			"modules": {
				"embedded:provider/builtin": "$(SUBPLATFORMDIRECTORY)/host/provider"
			}
		}
	},
	"defines": {
		"crypt": {
			"curve": {
				"p384": 0
			},
			"digest": {
				"md5": 0,
				"sha224": 0
			},
			"cipher": {
				"aes_ecb": 0,
				"aes_cbc": 0,
				"chacha20": 0,
				"chacha20_poly1305": 0
			}
		},
		"spi": {
			"miso_pin": 12,
			"mosi_pin": 13,
			"sck_pin": 14
		}
	}
}

