{
	"include": [
		"$(MODULES)/crypt/bin",
		"$(MODULES)/files/resource",
		"$(EMBEDDED)/crypt/cipher",
		"$(EMBEDDED)/crypt/random",
		"$(EMBEDDED)/crypt/key",
		"$(EMBEDDED)/crypt/signature",
		"$(EMBEDDED)/crypt/keyagreement",
		"$(EMBEDDED)/crypt/mac",
		"$(EMBEDDED)/crypt/keyderivation"
	],
	"modules": {
		"embedded:io/socket/tcp/tls": "$(EMBEDDED)/io/socket/tcp/tls/tlssocket",
		"config/tls": "$(EMBEDDED)/io/socket/tcp/tls/config",
		"ssl/session": "./session",
		"ssl/*": "./ssl_*",
		"*": "$(MODULES)/crypt/etc/x509.c",
		"ber": "$(MODULES)/crypt/etc/ber"
	},
	"preload": [
		"embedded:io/socket/tcp/tls",
		"config/tls",
		"ssl/session",
		"ssl/*",
		"ber"
	],
	"config": {
		"tls": {
			"ECDHE_RSA": true
		}
	},
	"resources": {
		"*": [
			"$(MODULES)/crypt/data/ca"
		]
	},
	"network": true
}
