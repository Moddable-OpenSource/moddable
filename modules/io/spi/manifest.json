{
	"platforms": {
		"mac": {},
		"win": {},
		"lin": {},
		"...": {
			"include": [
				"$(MODULES)/pins/spi/manifest.json"
			],
			"modules": {
				"*": [
					"$(MODULES)/io/common/builtinCommon",
					"$(MODULES)/io/spi/$(PLATFORM)/*",
					"$(MODULES)/commodetto/commodettoBitmap.h"
				],
				"embedded:io/spi": "$(IO)/spi/spi",
				"config/spi": "./config"
			},
			"dependency": [
				{ "idf": "esp_driver_spi" }
			],
			"preload": [
				"embedded:io/spi",
				"config/spi"
			]
		}
	}
}
