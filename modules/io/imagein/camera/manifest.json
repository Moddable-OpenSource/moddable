{
	"preload": [
		"embedded:io/image/in/camera"
	],
	"platforms": {
		"mac": {
			"include": [
				"$(COMMODETTO)/manifest_convert.json"
			],
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./mac/camera"
			}
		},
		"lin": {
			"include": [
				"$(COMMODETTO)/manifest_convert.json"
			],
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./lin/camera"
			}
		},
		"win": {
			"include": [
				"$(COMMODETTO)/manifest_convert.json"
			],
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./win/camera"
			}
		},
		"esp32": {
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./esp32/camera"
			},
			"dependency": [ {
				"name": "esp32-camera",
				"version": "^2.0.10",
				"includes": [
					"conversions/include",
					"driver/include"
				]
			},
			{
				"name": "esp_jpeg",
				"version": "^1.3.1"
			}]
		},
		"esp32/ws_esp32p4_wifi_3_5": {
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": [
					"./esp32/camera.js",
					"./esp32/camera-mipi.c"
				]
			},
			"defines": {
				"camera": {
					"reset": -1,
					"xclk": -1,
					"i2c_hz": 400000,
					"i2c_own": 0,
					"width": 1280,
					"height": 960,
					"width_max": 1280,
					"height_max": 960,
					"model": "#OV5647"
				}
			},
			"dependency": [
				{
					"name": "esp_video",
					"version": "^2.5.0"
				},
				{
					"name": "esp_cam_sensor",
					"version": "^2.6.0"
				},
				{
					"name": "esp_sccb_intf",
					"version": ">=0.0.5"
				},
				{ "idf": "esp_driver_jpeg" },
				{ "idf": "esp_hal_jpeg" }
			],
			"esp32Config": {
				"CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE": "y",
				"CONFIG_ESP_VIDEO_ENABLE_ISP": "y",
				"CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE": "y",
				"CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER": "n",
				"CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE": "n",
				"CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE": "n",
				"CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE": "n",
				"CONFIG_ESP_VIDEO_ENABLE_H264_VIDEO_DEVICE": "n",
				"CONFIG_ESP_VIDEO_ENABLE_JPEG_ENC_VIDEO_DEVICE": "n",
				"CONFIG_ESP_VIDEO_ENABLE_JPEG_DEC_VIDEO_DEVICE": "n",
				"CONFIG_CAMERA_XCLK_USE_ESP_CLOCK_ROUTER": "y",
				"CONFIG_CAMERA_OV5647": "y",
				"CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR": "y",
				"CONFIG_CAMERA_OV5647_MIPI_RAW8_800X640_50FPS": "n",
				"CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS": "n",
				"CONFIG_CAMERA_OV5647_MIPI_RAW8_800X1280_50FPS": "n",
				"CONFIG_CAMERA_OV5647_MIPI_RAW10_1920X1080_30FPS": "n",
				"CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS": "y",
				"CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X640_50FPS": "n",
				"CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X800_50FPS": "n",
				"CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X1280_50FPS": "n",
				"CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1920X1080_30FPS": "n",
				"CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS": "y",
				"CONFIG_CAMERA_OV5647_ENABLE_MOTOR_BY_GPIO0": "n"
			}
		},
		"pico": {
		},
		"...": {
			"error": "Image In unsupported"
		}
	}
}
