{
	"include": [
		"$(MODDABLE)/modules/io/crypt/psa"
	],
	"modules": {
		"embedded:crypt/signature": "./signature"
	},
	"preload": [
		"embedded:crypt/signature"
	],
	"dependency": [
		{
			"idf": "mbedtls"
		}
	],
	"platforms": {
		"zephyr": {
			"zephyrConfig": {
				"CONFIG_PSA_WANT_ALG_ECDSA": "y",
				"CONFIG_PSA_WANT_ALG_DETERMINISTIC_ECDSA": "y",
				"CONFIG_PSA_WANT_ALG_RSA_PSS": "y",
				"CONFIG_PSA_WANT_ALG_RSA_PKCS1V15_SIGN": "y"
			}
		}
	}
}
