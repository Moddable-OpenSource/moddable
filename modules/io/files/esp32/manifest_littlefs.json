{
	"include": [
		"$(MODULES)/base/modules/manifest.json"
	],
	"platforms": {
		"esp32": {
			"modules": {
				"embedded:x-files-implementation": "./files-vfs",
				"embedded:storage/files": "./files",
				"config/files": "../config"
			},
			"preload": [
				"embedded:x-files-implementation",
				"config/files"
			],
			"defines": {
				"file": {
					"partition": "#storage",
					"littlefs": 1
				}
			},
			"dependency": [
				{ "name": "littlefs", "namespace": "joltwallet", "version": "^1.14.0" }
			]
		}
	},
	"mcpack": false
}
