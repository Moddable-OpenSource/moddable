{
	"include": [
		"$(MODDABLE)/modules/base/worker",
		"$(MODDABLE)/modules/io",
		"$(MODDABLE)/modules/io/tls/client",
		"$(MODDABLE)/modules/data/headers",
		"$(MODDABLE)/modules/io/https/client",
		"$(MODDABLE)/modules/io/wss/client",
		"$(MODDABLE)/modules/io/audioin",
		"$(MODDABLE)/modules/io/audioout",
		"$(MODDABLE)/modules/data/text/encoder"
	],
	"data": { 
		"*": [
			"$(MODULES)/crypt/data/ca35",
			"$(MODULES)/crypt/data/ca109",
			"$(MODULES)/crypt/data/ca222",
			"$(MODULES)/crypt/data/ca233",
			"$(MODULES)/crypt/data/ca236"
		]
	},
	"defines": {
		"audioIn": {
			"bitsPerSample": 16,
			"numChannels": 1,
			"sampleRate": 24000
		},
		"audioOut": {
			"bitsPerSample": 16,
			"numChannels": 1,
			"sampleRate": 24000
		},
		"task": {
			"queueLength": 20
		}
	},
	"modules": {
		"*": [
			"./ChatAudioIO",
			"./workers/*"
		],
		"ChatAudioIO/Codecs": "./codecs/audio-codecs"
	},
	"preload": [
		"ChatAudioIO",
		"ChatAudioIO/Codecs",
		"ChatWorker",
		"ChatWebSocketWorker",
		"JSONBase64Parser",
		"alaw-encode"
	]
}
