{
	"include": [
		"$(MODDABLE)/examples/manifest_net.json",
		"$(MODDABLE)/modules/network/net",
		"$(MODDABLE)/modules/network/socket"
	],
	"platforms": {
		"qca4020": {
			"modules": {
				"*": [
					"$(BUILD)/devices/qca4020/modules/ping/*"
				]
			}
		},
		"...": {
			"modules": {
				"*": [
					"$(MODDABLE)/modules/network/ping/ping"
				]
			}
		}	
	},
	"preload": "ping"
}
