{
	"build": {
		"ETHERNET": "$(MODDABLE)/modules/network/ethernet"
	},
	"config": {
		"sntp": "pool.ntp.org"
	},
	"include": [
		"$(ETHERNET)",
		"$(MODULES)/network/net",
		"$(EMBEDDED)/network/dns/resolver",
		"$(EMBEDDED)/network/ntp/client",
		"$(EMBEDDED)/io/socket",
		"$(MODULES)/network/socket"
	],
	"platforms": {
		"esp32": {
			"modules": {
				"setup/ethernet": "$(ETHERNET)/esp32/setup/ethernet"
			},
			"preload": "setup/ethernet"
		},
		"lin": {},
		"mac": {},
		"win": {},
		"...": {
			"error": "manifest_net_ethernet - unsupported platform"
		}
	}
}
