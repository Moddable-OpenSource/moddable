{
	"include": [
		"$(MODULES)/pins/digital",
		"$(MODULES)/pins/i2c"
	],
	"modules": {
		"*": [
			"$(MODULES)/drivers/bmp280/*"
		]
	},
	"preload": [
		"bmp280"
	],
	"platforms": {
		"gecko": {
			"modules": {
				"*": "$(MODULES)/drivers/bmp280/gecko/*"
			}
		},
		"...": {
			"error": "bmp280 unsupported"
		}
	}
}
