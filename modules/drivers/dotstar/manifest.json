{
	"defines": {
		"dotstar": {
			"brightness": 16
		}
	},
	"preload": [
		"dotstar"
	],
	"platforms": {
		"esp": {
			"include": [
				"$(MODULES)/pins/spi",
				"$(COMMODETTO)/manifest_bitmap.json"
			],
			"modules": {
				"*": "$(MODULES)/drivers/dotstar/*"
			},
			"defines": {
				"dotstar": {
					"spi_port": "#HSPI"
				}
			}
		},
		"esp32": {
			"include": [
				"$(MODULES)/pins/spi",
				"$(COMMODETTO)/manifest_bitmap.json"
			],
			"modules": {
				"*": "$(MODULES)/drivers/dotstar/*"
			},
			"defines": {
				"dotstar": {
					"spi_port": "HSPI_HOST"
				}
			}
		}
	}
}
