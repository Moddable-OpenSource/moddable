{
	"defines": {
		"ssd1351": {
			"width": 128,
			"height": 128
		}
	},
	"preload": [
		"ssd1351"
	],
	"platforms": {
		"esp": {
			"include": [
				"$(MODULES)/pins/digital",
				"$(MODULES)/pins/spi",
				"$(COMMODETTO)/manifest_bitmap.json"
			],
			"modules": {
				"*": "$(MODULES)/drivers/ssd1351/*"
			},
			"defines": {
				"ssd1351": {
					"cs_pin": 4,
					"dc_pin": 2,
					"spi_port": "#HSPI"
				}
			}
		},
		"esp32": {
			"include": [
				"$(MODULES)/pins/digital",
				"$(MODULES)/pins/spi",
				"$(COMMODETTO)/manifest_bitmap.json"
			],
			"modules": {
				"*": "$(MODULES)/drivers/ssd1351/*"
			},
			"defines": {
				"ssd1351": {
					"cs_pin": 4,
					"dc_pin": 2,
					"spi_port": "HSPI_HOST"
				}
			}
		}
	}
}
