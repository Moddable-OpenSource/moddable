{
	"warning": "** ECMA-419 Pulse Count recommended over classic 'pins/pulsecount' module **",
	"include": [
		"$(MODULES)/pins/digital",
		"$(MODULES)/pins/digital/monitor"
	],
	"modules": {
		"pins/pulsecount": "$(MODULES)/pins/pulsecount/*"
	},
	"preload": "pins/pulsecount",
	"platforms": {
		"esp32": {
			"modules": {
				"*": "$(MODULES)/pins/pulsecount/esp32/*"
			}
		},
		"nrf52": {
			"modules": {
				"*": "$(MODULES)/pins/pulsecount/nrf52/*"
			}
		},
		"...": {
			"error": "pins/digital module unsupported"
		}
	}
}
