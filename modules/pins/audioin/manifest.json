{
	"warning": "** ECMA-419 Audio In recommended over classic 'pins/audioin' module **",
	"preload": "audioin",
	"platforms": {
		"esp32/*": {
			"modules": {
				"*": [
					"./audioin",
					"./esp32/audioin"
				]
			},
			"dependency": [
				{ "idf": "esp_driver_i2s" },
				{ "idf": "esp_adc" }
			]
		},
		"...": {
			"warning": "Using AudioIn simulator",
			"include": [
				"$(MODDABLE)/modules/data/wavreader"
			],
			"modules": {
				"*": "./sim/audioin"
			},
			"data": {
				"sim": "$(MODDABLE)/examples/assets/sounds/bflatmajor"
			}
		}
	}
}
