{
	"platforms": {
		"esp32": {
			"modules": {
				"embedded:io/pulsecount": "$(EMBEDDED)/io/pulsecount/$(PLATFORM)/*",
				"*": [
					"$(EMBEDDED)/common/builtinCommon"
				],
				"config/pulsecount": "./config"
			},
			"dependency": [
				{ "idf": "esp_driver_pcnt" }
			]
		},
		"nrf52": {
			"modules": {
				"embedded:io/pulsecount": "$(EMBEDDED)/io/pulsecount/$(PLATFORM)/*",
				"*": [
					"$(EMBEDDED)/common/builtinCommon"
				],
				"config/pulsecount": "./config"
			}
		},
		"pico": {
			"modules": {
				"embedded:io/pulsecount": "$(EMBEDDED)/io/pulsecount/$(PLATFORM)/*",
				"*": [
					"$(EMBEDDED)/common/builtinCommon"
				],
				"config/pulsecount": "./config"
			}
		}
	},
	"preload": [
		"embedded:io/pulsecount",
		"config/pulsecount"
	]
}
