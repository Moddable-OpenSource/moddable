{
	"platforms": {
		"esp32": {
			"modules": {
				"embedded:io/pulsewidth": "$(IO)/pulsewidth/$(PLATFORM)/*",
				"*": [
					"$(EMBEDDED)/common/builtinCommon"
				],
				"config/pulsewidth": "./config"
			},
			"dependency": [
				{ "idf": "esp_driver_mcpwm" }
			]
		}
	},
	"preload": [
		"embedded:io/pulsewidth",
		"config/pulsewidth"
	]
}
