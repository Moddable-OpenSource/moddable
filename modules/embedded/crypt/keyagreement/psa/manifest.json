{
	"include": [
		"$(EMBEDDED)/crypt/psa"
	],
	"modules": {
		"embedded:crypt/keyagreement": "$(EMBEDDED)/crypt/keyagreement/keyagreement-native",
		"*": "./keyagreement"
	},
	"preload": [
		"embedded:crypt/keyagreement"
	],
	"dependency": [
		{
			"idf": "mbedtls"
		}
	],
	"platforms": {
		"zephyr": {
			"zephyrConfig": {
				"CONFIG_PSA_WANT_ALG_ECDH": "y"
			}
		}
	}
}
