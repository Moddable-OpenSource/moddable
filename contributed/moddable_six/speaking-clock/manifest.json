{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/modules/io",
		"$(MODDABLE)/examples/manifest_piu.json",
		"$(MODDABLE)/modules/piu/MC/outline",
		"$(MODDABLE)/modules/pins/i2s"
	],
	"modules": {
		"*": [
			"./main",
			"./data"
		]
	},
	"defines": {
		"audioOut": {
			"bitsPerSample": 16,
			"numChannels": 1,
			"sampleRate": 24000,
			"queueLength": 24
		}
	},
	"config": {
		"led": {
			"rainbow": false
		},
		"startupSound": false
	},
    "data": {
    	"*": "./data/*"
    },
    "preload": [
    	"data"
    ]
}
