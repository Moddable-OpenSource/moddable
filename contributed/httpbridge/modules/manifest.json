{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_net.json",
		"$(MODULES)/network/http",
		"$(MODULES)/network/websocket",
		"$(MODULES)/files/zip",
		"$(MODDABLE)/modules/network/net",
		"$(MODDABLE)/modules/network/socket"
	],
	"modules": {
		"*": [
			"$(MODULES)/files/resource/*"
		],
		"dns/server": "$(MODULES)/network/dns/dnsserver"
	},
	"preload": [
		"http",
		"dns/server",
        "websocket/websocket",
		"base64",
		"hex",
		"logical",
		"resource",
		"zip"
	]
}
