{
	"include": [
		"./manifest_common.json",
		"$(MODDABLE)/examples/manifest_piu.json",
		"$(MODDABLE)/contributed/jsonparser",
		"$(MODULES)/base/deepEqual",
		"$(MODULES)/base/structuredClone",
		"$(MODULES)/data/base64",
		"$(MODULES)/data/crc",
		"$(MODULES)/data/hex",
		"$(MODULES)/data/qrcode",
		"$(MODULES)/data/text/decoder",
		"$(MODULES)/data/text/encoder",
		"$(MODULES)/data/url",
		"$(MODULES)/data/zlib/manifest_deflate.json",
		"$(MODULES)/data/zlib/manifest_inflate.json",
		"$(MODULES)/files/preference",
		"$(MODULES)/crypt/digest",
		"$(MODDABLE)/modules/io/files",
		"$(MODDABLE)/modules/piu/MC/colorcell",
		"$(MODDABLE)/modules/io/flash",
		"$(MODDABLE)/modules/io/storage",
		"$(MODDABLE)/modules/io/audioout",
		"$(MODDABLE)/modules/io/audioin",
		"$(MODDABLE)/modules/io/crypt/digest",
		"$(MODDABLE)/modules/io/update",
		"$(MODDABLE)/modules/io/flash",
		"$(COMMODETTO)/manifest_bitmap.json",
		"$(COMMODETTO)/manifest_parsebmf.json"
	],
	"modules": {
		"*": [
			"./testworker",
			"./testsharedworker",
			"./testthrowworker",
			"$(MODULES)/base/instrumentation/*"
		],
		"~": [
			"$(MODDABLE)/tools/testmc/commodettoChecksumOut-nop"
		],
		"commodetto/Poco": "$(MODULES)/commodetto/commodettoPoco",
		"commodetto/*": "$(MODULES)/commodetto/commodettoPocoBlit",
		"commodetto/cfe": "$(MODULES)/commodetto/cfeBMF",
		"commodetto/checksumOut": "./commodettoChecksumOut",
        "piu/Sound": "$(MODULES)/piu/MC/piuSound"
	},
	"preload": [
		"commodetto/*",
		"piu/Sound"
	],
	"config": {
		"format": "RGB565LE"
	},
	"platforms": {
		"mac": {
			"config": {
				"flash": {
					"xs_test": { "blocks":10, "blockLength":1024 },
					"running": { "blocks":20, "blockLength":1024, "bytes":[ 249 ] },
					"nextota": { "blocks":10, "blockLength":1024 }
				}
			}
		},
		"zephyr": {
			"include": [
				"$(MODULES)/base/worker"
			]
		},
		"pico": {
			"defines": {
				"audioOut": {
					"bitsPerSample": 16,
					"numChannels": 1,
					"sampleRate": 12000,
					"streams": 2,
					"queueLength": 4
				}
			},
			"include": [
				"$(MODULES)/base/worker",
				"$(MODULES)/files/flash",
				"$(MODDABLE)/modules/pins/i2s"
			],
			"config": {
				"digital": [12, 13, 16, 17, 26, 27],
				"flashPartition": "xs_test",
				"i2c": {
					"hz": 100000,
					"address": 53,
					"unusedAddress": 99
				},
				"pwm": {
					"from": true,
					"pins": [18, 12, 13],
					"ports": [4, 5],
					"invalidPorts": [0, 1],
					"resolutions": [10, 11, 12],
					"hzs": [10000, 200, 17]
				},
				"spi": {
					"select": 18,
					"ports": [1, 2],
					"invalidPorts": [3, -1],
					"hzs": [1000, 10000, 20000]
				},
			 	"invalidPins": [
					-10,
					500
				]
			}
		},
		"esp32": {
			"include": [
				"./manifest_net.json",
				"./manifest_ble.json",
				"$(MODULES)/base/worker",
				"$(MODULES)/files/flash",
				"$(MODDABLE)/modules/pins/i2s"
			],
			"defines": {
				"audioOut": {
					"bitsPerSample": 16,
					"numChannels": 1,
					"sampleRate": 12000,
					"streams": 2,
					"queueLength": 4
				}
			},
			"config": {
				"digital": [12, 13, 16, 17, 26, 27],
				"flashPartition": "xs_test",
				"i2c": {
					"hz": 100000,
					"address": 53,
					"unusedAddress": 99
				},
				"pwm": {
					"from": true,
					"pins": [18, 12, 13],
					"ports": [4, 5],
					"invalidPorts": [0, 1],
					"resolutions": [10, 11, 12],
					"hzs": [10000, 200, 17]
				},
				"spi": {
					"select": 18,
					"ports": [1, 2],
					"invalidPorts": [3, -1],
					"hzs": [1000, 10000, 20000]
				},
			 	"invalidPins": [
					-10,
					500
				]
			}
		},
		"esp32/moddable_six": {
			"include": [
				"./manifest_net.json",
				"./manifest_ble.json",
				"$(MODULES)/base/worker",
				"$(MODULES)/files/flash",
				"$(MODDABLE)/modules/pins/i2s"
			],
			"defines": {
				"audioOut": {
					"bitsPerSample": 16,
					"numChannels": 1,
					"sampleRate": 12000,
					"streams": 2,
					"queueLength": 4
				}
			},
			"config": {
				"digital": [16, 17, 0, 1, 2, 3],
				"flashPartition": "xs_test",
				"i2c": {
					"hz": 100000,
					"address": 53,
					"unusedAddress": 99
				},
				"pwm": {
					"from": true,
					"pins": [1, 16],
					"ports": [4, 5],
					"invalidPorts": [0, 1],
					"resolutions": [10, 11, 12],
					"hzs": [10000, 200, 17]
				},
				"spi": {
					"select": 18,
					"ports": [1, 2],
					"invalidPorts": [3, -1],
					"hzs": [1000, 10000, 20000]
				},
			 	"invalidPins": [
					-10,
					500
				]
			}
		}
	},
	"data": {
		"*": [
			"$(MODDABLE)/examples/assets/images/image-info",
			"$(MODULES)/crypt/data/ca34",
			"$(MODULES)/crypt/data/ca35",
			"$(MODULES)/crypt/data/ca109",
			"$(MODULES)/crypt/data/ca170",
			"$(MODULES)/crypt/data/ca179",
			"$(MODULES)/crypt/data/ca222",
			"$(MODULES)/crypt/data/ca233",
			"$(MODULES)/crypt/data/ca236",
			"./assets/bflatmajor-ima-12000",
			"./assets/bflatmajor-ima-16000",
			"./assets/bflatmajor-sbc",
			"./assets/mosquitto.org"
		]
	},
	"resources": {
		"*-mask": [
			"$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-16",
            "./assets/circleish"
		],
		"*" : [
			"./assets/color-dots-20"
		],
		"*-image": [
			"$(MODDABLE)/examples/assets/images/robby"
		],
		"*-image(40)": [
			"$(MODDABLE)/examples/assets/images/screen2"
		]
	}
}
