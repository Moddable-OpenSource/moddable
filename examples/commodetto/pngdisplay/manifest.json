{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_net.json",
		"$(MODDABLE)/examples/manifest_commodetto.json",
		"$(MODDABLE)/modules/io/dnssd",
		"$(MODDABLE)/modules/io/wifiaccesspoint",
		"$(MODDABLE)/modules/io/http/server",
		"$(COMMODETTO)/manifest_bitmap.json",
		"$(COMMODETTO)/manifest_convert.json",
		"$(COMMODETTO)/manifest_readpng.json"
	],
	"modules": {
		"*": "./main"
	},
	"preload": [
		"main"
	],
	"config": {
		"touch": ""
	},
	"bundle": {
	    "id": "tech.moddable.pngdisplay",
	    "devices": [
	        "esp32/moddable_two",
	        "esp32/moddable_display_2",
	        "esp32/m5stack",
	        "esp32/m5stack_core2",
	        "esp32/m5stack_fire"
	    ],
	    "custom": "./store/custom"
	}
}

