{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(EMBEDDED)/io",
		"$(EMBEDDED)/io/audio/out"
	],
	"config": {
		"startupSound": false
	},
	"defines": {
		"audioOut": {
			"bitsPerSample": 16,
			"numChannels": 1,
			"sampleRate": 24000
		}
	},
	"modules": {
		"*": [
			"./main",
			{
				"source": "$(MODDABLE)/modules/data/views/maud/maudHeader",
				"transform": "cdv",
				"json": false,
				"get": true,
				"set": false
			}
		]
	},
	"preload": [
		"maudHeader"
	],
    "resources": {
		"*": [
    		"$(MODDABLE)/examples/assets/sounds/one",
    		"$(MODDABLE)/examples/assets/sounds/two"
		]
    }
}
