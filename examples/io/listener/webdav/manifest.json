{
	"build": {
		"NAME": "webdav-listener"
	},
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_net.json",
		"$(MODDABLE)/modules/network/net",
		"$(MODDABLE)/modules/io/files",
		"$(MODDABLE)/modules/io/http/server",
		"$(MODDABLE)/modules/io/http/server/route/static",
		"$(MODDABLE)/modules/io/http/server/route/webdav"
	],
	"modules": {
		"*": "./main"
	},
	"defines": {
		"file": {
			"lfs": {
				"read_size": 512,
				"prog_size": 512,
				"cache_size": 512,
				"lookahead_size": 512
			}
		}
	},
	"platforms": {
		"esp": {
			"creation": {
				"static": 24576
			}
		},
		"pico": {
			"defines": {
				"file": {
					"lfs": {
						"partition_size": 1048576
					}
				}
			}
		},
		"esp32/moddable_six": {
			"build": {
				"PARTITIONS_FILE": "./partitions.csv"
			}
		}
	}
}
