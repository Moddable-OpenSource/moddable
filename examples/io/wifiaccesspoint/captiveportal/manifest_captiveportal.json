{
	"include": [
		"$(EMBEDDED)/network/interface/wifi/accesspoint"
	],
	"preload": "captiveportal",
	"platforms": {
		"mac": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"lin": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"win": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"...": {
			"include": [
				"$(EMBEDDED)/network/dns/server",
				"$(EMBEDDED)/network/http/server",
				"$(EMBEDDED)/network/http/server/route/static",
				"$(EMBEDDED)/network/http/server/route/ws/handshake",
				"$(EMBEDDED)/network/ws/client"
			],
			"modules": {
				"captiveportal": "./captiveportal"
			}
		}
	},
	"mcpack": true
}
