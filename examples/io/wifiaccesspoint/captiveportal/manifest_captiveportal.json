{
	"include": [
		"$(MODULES)/io/wifiaccesspoint"
	],
	"preload": "captiveportal",
	"platforms": {
		"mac": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"lin": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"win": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"...": {
			"include": [
				"$(MODDABLE)/examples/io/udp/dns/manifest_dnsserver.json",
				"$(MODDABLE)/examples/io/listener/httpserver/manifest_httpserver.json",
				"$(MODDABLE)/examples/io/tcp/websocketclient/manifest_websocketclient.json"
			],
			"modules": {
				"captiveportal": "./captiveportal"
			}
		}
	},
	"mcpack": true
}
