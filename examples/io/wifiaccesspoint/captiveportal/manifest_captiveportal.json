{
	"include": [
		"$(MODULES)/io/wifiaccesspoint"
	],
	"preload": "captiveportal",
	"platforms": {
		"mac": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"lin": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"win": {
			"modules": {
				"captiveportal": "./captiveportal-sim"
			}
		},
		"...": {
			"include": [
				"$(MODDABLE)/modules/io/dns/server",
				"$(MODDABLE)/modules/io/http/server",
				"$(MODDABLE)/modules/io/http/server/route/static",
				"$(MODDABLE)/modules/io/http/server/route/ws/handshake",
				"$(MODDABLE)/modules/io/ws/client"
			],
			"modules": {
				"captiveportal": "./captiveportal"
			}
		}
	},
	"mcpack": true
}
