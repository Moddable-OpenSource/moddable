{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/modules/io",
		"$(COMMODETTO)/manifest_bitmap.json",
		"$(COMMODETTO)/manifest_parsebmf.json",
		"$(COMMODETTO)/manifest_parsebmp.json",
		"$(COMMODETTO)/manifest_parserle.json"
	],
	"modules": {
		"embedded:display/LCD/ILI9341": "./display",
		"commodetto/Poco": "$(COMMODETTO)/commodettoPoco",
		"commodetto/PocoCore": "$(COMMODETTO)/commodettoPocoCore",
		"commodetto/*": "$(COMMODETTO)/commodettoPocoBlit",
		"commodetto/cfe": "$(COMMODETTO)/cfeBMF",
		"piu/*": "$(PIU)/All/piu*",
		"piu/MC": "$(PIU)/MC/piuMC",
		"*": [
			"./main",
			"$(PIU)/MC/piuDie",
			"$(PIU)/MC/piuFont",
			"$(PIU)/MC/piuImage",
			"$(PIU)/MC/piuRegion",
			"$(PIU)/MC/piuTexture",
			"$(PIU)/MC/piuView"
		]
	},
	"preload": [
		"embedded:display/LCD/ILI9341",
		"commodetto/*",
		"piu/*"
	],
    "defines": {
		"display": {
			"version": 2
		}
    }
}
