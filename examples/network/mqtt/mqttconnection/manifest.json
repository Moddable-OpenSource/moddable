{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_net.json",
		"$(MODDABLE)/modules/network/mqtt",
		"$(MODDABLE)/modules/network/net",
		"$(MODDABLE)/modules/network/wifi"
	],
	"modules": {
		"*": [
			"./main"
		],
		"mqtt/connection": "./mqttconnection",
		"wifi/connection": "../../wifi/wificonnection/wificonnection"
	},
	"preload": [
		"mqtt/connection",
		"wifi/connection"
	],
	"platforms": {
		"esp": {
			"modules": {
				"~": "$(BUILD)/devices/$(PLATFORM)/setup/network"
			}
		},
		"esp32": {
			"modules": {
				"~": "$(BUILD)/devices/$(PLATFORM)/setup/network"
			}
		}
	}
}

