{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/modules/io",
		"$(MODDABLE)/modules/io/http/client",
		"$(MODDABLE)/modules/data/mp3",
		"./manifest_mp3streamer.json"
	],
	"modules": {
		"*": [
			"./main",
			"../http-stream/calculatePower"
		],
		"pins/*": [
			"$(MODULES)/pins/i2s/*"
		]
	},
	"defines": {
		"audioOut": {
			"bitsPerSample": 16,
			"numChannels": 1,
			"queueLength": 12
		}
	},
	"config": {
		"startupSound": false
	}
}
