{
	"build": {
		"TYPINGS": "$(MODDABLE)/typings"
	},
	"modules": {
		"*": [
			"$(TYPINGS)/*", "$(TYPINGS)/ble/*"
		],
		"commodetto/*": [
			"$(TYPINGS)/commodetto/*"
		],
		"config/*": [
			"$(TYPINGS)/config/*"
		],
		"dns/*": [
			"$(TYPINGS)/dns/*"
		],
		"mc/*": [
			"$(TYPINGS)/mc/*"
		],
		"mod/*": [
			"$(TYPINGS)/mod/*"
		],
		"pins/*": [
			"$(TYPINGS)/pins/*"
		],
		"piu/*": [
			"$(TYPINGS)/piu/*"
		],
		"ssl/*": [
			"$(TYPINGS)/ssl/*"
		],
		"text/*": [
			"$(TYPINGS)/text/*"
		],
		"embedded:io/*": [
			"$(TYPINGS)/embedded_io/*"
		],
		"embedded:io/audio/*": [
			"$(TYPINGS)/embedded_io/audio/*"
		],
		"embedded:io/image/in/*": [
			"$(TYPINGS)/embedded_io/image/in/*"
		],
		"embedded:io/bluetoothle/*": [
			"$(TYPINGS)/embedded_io/ble/*"
		],
		"embedded:io/crypt/*": [
			"$(TYPINGS)/embedded_io/crypt/*"
		],
		"embedded:io/socket/*": [
			"$(TYPINGS)/embedded_io/socket/*"
		],
		"embedded:io/socket/tcp/*": [
			"$(TYPINGS)/embedded_io/socket/tcp/*"
		],
		"embedded:network/http/*": [
			"$(TYPINGS)/embedded_network/http/*"
		],
		"embedded:network/http/server/route/*": [
			"$(TYPINGS)/embedded_network/http/server/route/*"
		],
		"embedded:network/http/server/route/ws/*": [
			"$(TYPINGS)/embedded_network/http/server/route/ws/*"
		],
		"embedded:network/mqtt/*": [
			"$(TYPINGS)/embedded_network/mqtt/*"
		],
		"embedded:network/websocket/*": "$(TYPINGS)/embedded_network/websocket/*",
		"embedded:network/dns/server/*": [
			"$(TYPINGS)/embedded_network/dns/server/*"
		],
		"embedded:network/dns/resolver/*": [
			"$(TYPINGS)/embedded_network/dns/resolver/*"
		],
		"embedded:network/interface/*": [
			"$(TYPINGS)/embedded_network/interface/*"
		],
		"embedded:network/interface/wifi/*": [
			"$(TYPINGS)/embedded_network/interface/wifi/*"
		],
		"embedded:network/ntp/*": [
			"$(TYPINGS)/embedded_network/ntp/*"
		],
		"embedded:network/*": [
			"$(TYPINGS)/embedded_network/*"
		],
		"embedded:*": [
			"$(TYPINGS)/embedded/*"
		],
		"embedded:storage/*": [
			"$(TYPINGS)/embedded/storage/*"
		],
		"embedded:RTC/*": [
			"$(TYPINGS)/embedded/RTC/*"
		],
		"mqtt/js": [
			"$(TYPINGS)/mqtt/js"
		],
		"headers": [
			"$(TYPINGS)/web/headers"
		],
		"fetch": [
			"$(TYPINGS)/web/fetch"
		],
		"web/fetch/streams": [
			"$(TYPINGS)/web/fetch-streams"
		],
		"structuredClone": [
			"$(TYPINGS)/web/structuredClone"
		],
		"url": [
			"$(TYPINGS)/web/url"
		],
		"webstorage": [
			"$(TYPINGS)/web/webstorage"
		],
		"web-bluetooth": [
			"$(TYPINGS)/web/bluetooth"
		],
		"web/serial": [
			"$(TYPINGS)/web/serial"
		],
		"web/abortsignal": [
			"$(TYPINGS)/web/abortsignal"
		],
		"web/console": [
			"$(TYPINGS)/web/console"
		],
		"web/decompressionstream": [
			"$(TYPINGS)/web/decompressionstream"
		],
		"eventsource": [
			"$(TYPINGS)/web/eventsource"
		],
		"web/eventsource": [
			"$(TYPINGS)/web/eventsource"
		],
		"web/streams": [
			"$(TYPINGS)/web/streams"
		],
		"web/timer": [
			"$(TYPINGS)/web/timers"
		],
		"web/textdecoderstream": [
			"$(TYPINGS)/web/textdecoderstream"
		],
		"web/textencoderstream": [
			"$(TYPINGS)/web/textencoderstream"
		],
		"WebSocket": [
			"$(TYPINGS)/web/websocket"
		],
		"web/websocket": [
			"$(TYPINGS)/web/websocket"
		],
		"web/websocketstream": [
			"$(TYPINGS)/web/websocketstream"
		],
		"worker": [
			"$(TYPINGS)/web/worker"
		]
	}, 
	"platforms": {
		"pebble": {
			"modules": {
				"embedded:sensor/Accelerometer": "$(TYPINGS)/pebble/accelerometer",
				"embedded:sensor/Battery": "$(TYPINGS)/pebble/battery",
				"embedded:sensor/Compass": "$(TYPINGS)/pebble/compass",
				"embedded:sensor/Location": "$(TYPINGS)/pebble/location",
				"embedded:provider/builtin": "$(TYPINGS)/pebble/device",
				"pebble/button": "$(TYPINGS)/pebble/button",
				"pebble/dictation": "$(TYPINGS)/pebble/dictation",
				"pebble/health": "$(TYPINGS)/pebble/health",
				"pebble/message": "$(TYPINGS)/pebble/message",
				"pebble/vibes": "$(TYPINGS)/pebble/vibes",
				"pebble/wakeup": "$(TYPINGS)/pebble/wakeup"
			},
			"typescript": {
				"tsconfig": {
					"compilerOptions": {
						"types": [
							"$(TYPINGS)/pebble/global",
							"$(TYPINGS)/pebble/piu",
							"$(TYPINGS)/pebble/poco",
							"$(TYPINGS)/easing",
							"$(TYPINGS)/piu/MC",
							"$(TYPINGS)/piu/MC-types"
						]
					}
				}
			}
		},
		"...": {
			"modules": {
				"embedded:provider/*": [
					"$(TYPINGS)/embedded_provider/*"
				]
			}
		}
	}
}
