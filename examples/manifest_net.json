{
	"config": {
		"sntp": "pool.ntp.org"
	},
	"platforms": {
		"esp": {
			"include": [
				"$(EMBEDDED)/network/dns/resolver",
				"$(EMBEDDED)/network/ntp/client",
				"$(EMBEDDED)/network/interface/wifi",
				"$(EMBEDDED)/io/socket"
			],
			"modules": {
				"setup/network": "$(BUILD)/devices/esp/setup/network"
			},
			"preload": "setup/network"
		},
		"esp32": {
			"include": [
				"$(EMBEDDED)/network/dns/resolver",
				"$(EMBEDDED)/network/ntp/client",
				"$(EMBEDDED)/network/interface/wifi",
				"$(EMBEDDED)/io/socket"
			],
			"modules": {
				"setup/network": "$(BUILD)/devices/esp32/setup/network"
			},
			"preload": "setup/network"
		},
		"esp32/wt32_eth01": {
			"include": [
				"$(EMBEDDED)/network/dns/resolver",
				"$(EMBEDDED)/network/ntp/client",
				"$(EMBEDDED)/network/interface/wifi",
				"$(MODDABLE)/modules/network/ethernet/manifest_net_ethernet.json",
				"$(EMBEDDED)/io/socket"
			],
			"modules": {
				"setup/network": "$(BUILD)/devices/esp32/setup/network"
			},
			"preload": "setup/network"
		},
		"nrf52": {
			"error": "manifest_net - no Wi-Fi or Ethernet on nRF52"
		},
		"pico": {
			"include": [
				"$(EMBEDDED)/network/dns/resolver",
				"$(EMBEDDED)/network/ntp/client",
				"$(EMBEDDED)/network/interface/wifi",
				"$(EMBEDDED)/io/socket"
			],
			"modules": {
				"setup/network": "$(BUILD)/devices/pico/setup/network"
			},
			"preload": [
				"setup/network"
			]
		},
		"qca4020": {
			"include": [
				"$(MODULES)/network/net",
				"$(MODULES)/network/socket",
				"$(MODULES)/network/sntp",
				"$(MODULES)/network/wifi"
			],
			"modules": {
				"setup/network": "$(BUILD)/devices/qca4020/setup/network"
			},
			"preload": "setup/network"
		},	
		"zephyr": {
			"include": [
				"$(EMBEDDED)/network/dns/resolver",
				"$(EMBEDDED)/network/ntp/client",
				"$(EMBEDDED)/network/interface/wifi",
				"$(EMBEDDED)/io/socket"
			],
			"modules": {
				"setup/network": "$(BUILD)/devices/zephyr/setup/network"
			},
			"preload": [
				"setup/network"
			]
		},
		"mac": {
			"include": [
				"$(EMBEDDED)/network/dns/resolver",
				"$(EMBEDDED)/network/ntp/client",
				"$(EMBEDDED)/network/interface/wifi",
				"$(EMBEDDED)/io/socket"
			]
		},
		"lin": {
			"include": [
				"$(EMBEDDED)/network/dns/resolver",
				"$(EMBEDDED)/network/ntp/client",
				"$(EMBEDDED)/network/interface/wifi",
				"$(EMBEDDED)/io/socket"
			]
		},
		"win": {
			"include": [
				"$(EMBEDDED)/network/dns/resolver",
				"$(EMBEDDED)/network/ntp/client",
				"$(EMBEDDED)/network/interface/wifi",
				"$(EMBEDDED)/io/socket"
			]
		},
		"...": {
			"error": "manifest_net - unsupported platform"
		}
	}
}
