{
	"build": {
		"BUILD": "$(MODDABLE)/build",
		"MODULES": "$(MODDABLE)/modules",
		"COMMODETTO": "$(MODULES)/commodetto",
		"PIU": "$(MODULES)/piu",
		"IO": "$(MODDABLE)/modules/io"
	},
	"creation": {
		"keys": {
			"initial": 32,
			"incremental": 32,
			"name": 53,
			"symbol": 3
		},
		"parser": {
			"buffer": 1024,
			"table": 17
		},
		"main": "main"
	},
	"defines": {
		"ECMA419": {
			"enabled": 1
		}
	},
	"include": [
		"$(MODULES)/files/resource",
		"$(MODDABLE)/examples/manifest_typings.json"
	],
	"modules": {
		"*": [
			"$(MODULES)/base/instrumentation/modInstrumentation"
		]
	},
	"strip": "*",
	"typescript": {
		"tsconfig": {
			"compilerOptions": {
				"types": [
					"$(MODDABLE)/typings/xs",
					"$(MODDABLE)/typings/global"
				]
			}
		}
	},
	"platforms": {
		"esp": {
			"include": "$(BUILD)/devices/esp",
			"modules": {
				"*": [
					"$(MODULES)/network/socket/lwip/modLwipSafe"
				]
			}
		},
		"esp32": {
			"include": "$(BUILD)/devices/esp32",
			"modules": {
				"*": "$(MODULES)/network/socket/lwip/modLwipSafe"
			}
		},
		"pico": {
			"include": "$(BUILD)/devices/pico"
		},
		"zephyr": {
			"include": "$(BUILD)/devices/zephyr"
		},
		"gecko": {
			"include": "$(BUILD)/devices/gecko"
		},
		"qca4020": {
			"include": "$(BUILD)/devices/qca4020"
		},
		"nrf52": {
			"include": "$(BUILD)/devices/nrf52",
			"creation": {
				"static": 131072,
				"chunk": {
					"initial": 32768
				},
				"heap": {
					"initial": 2048
				},
				"stack": 512
			}
		},
		"lin": {
			"include": "$(BUILD_SIMULATOR)"
		},
		"mac": {
			"include": "$(BUILD_SIMULATOR)"
		},
		"win": {
			"include": "$(BUILD_SIMULATOR)"
		},
		"wasm": {
			"include": "$(BUILD_SIMULATOR)"
		},
		"pebble": {
			"include": "$(BUILD)/devices/pebble"
		}
	}
}
